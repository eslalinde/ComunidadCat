{
  "name": "comunidadcat",
  "description": "Manejo de comunidades neocatecumenales",
  "author": {
    "name": "Esteban Lalinde",
    "email": "esteban.lalinde@gmail.com"
  },
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/eslalinde/ComunidadCat"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:e2e": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/test-database.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "electron:dev": "npm run build && tsc -p electron/tsconfig.json && electron .",
    "electron:build": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win",
    "electron:build:dir": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win --dir",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/auth e2e/ui-lab",
    "test:e2e:regression": "playwright test e2e/roles e2e/reports e2e/ui",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test:electron": "npm run build && tsc -p electron/tsconfig.json && playwright test --config playwright.electron.config.ts",
    "ui:audit": "node scripts/ui-audit.mjs",
    "seed:e2e": "tsx scripts/seed-test-users.ts"
  },
  "dependencies": {
    "@babel/runtime": "^8.1.3",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/nextjs": "11.16.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/table-core": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compare-versions": "6.1.1",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.1",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^28.1.0",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
