{
  "name": "comunidadcat",
  "description": "Manejo de comunidades neocatecumenales",
  "author": {
    "name": "Esteban Lalinde",
    "email": "esteban.lalinde@gmail.com"
  },
  "version": "1.0.0-beta.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/eslalinde/VibeCaminoManager"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "electron:dev": "npm run build && tsc -p electron/tsconfig.json && electron .",
    "electron:build": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win",
    "electron:build:dir": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win --dir",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test:electron": "tsc -p electron/tsconfig.json && playwright test --config playwright.electron.config.ts",
    "ui:audit": "node scripts/ui-audit.mjs",
    "seed:e2e": "tsx scripts/seed-test-users.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/nextjs": "^10.59.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.2",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.577.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "radix-ui": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.80.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^28.1.0",
    "pg": "^8.20.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
